{
	"name": "scramjet-demo",
	"version": "2.0.0",
	"description": "The demo application for Scramjet, a high-performance web proxy.",
	"type": "module",
	"engines": {
		"npm": ">=7.0.0",
		"node": ">=20.19.0"
	},
	"scripts": {
		"build": "node --check src/index.js && node scripts/build-static.mjs && vite build --config vite.config.js",
		"dev": "vite --config vite.config.js",
		"start": "node src/index.js",
		"test": "node --test",
		"format": "prettier --write .",
		"lint": "eslint ./src/",
		"lint:fix": "eslint ./src/ --fix"
	},
	"keywords": [
		"proxy"
	],
	"author": "Mercury Workshop",
	"license": "GNU AFFERO",
	"dependencies": {
		"@supabase/supabase-js": "^2.57.4",
		"@fastify/static": "^9.0.0",
		"@mercuryworkshop/bare-mux": "^2.1.9",
		"@mercuryworkshop/libcurl-transport": "^1.5.2",
		"@mercuryworkshop/scramjet": "https://github.com/MercuryWorkshop/scramjet/releases/download/v1.1.0/mercuryworkshop-scramjet-1.1.0.tgz",
		"@vercel/analytics": "^2.0.1",
		"fastify": "^5.7.4",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"eslint": "^9.13.0",
		"prettier": "^3.3.3",
		"vite": "^7.1.3"
	},
	"packageManager": "pnpm@10.18.3"
}
