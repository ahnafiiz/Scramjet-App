# === LOCAL DEPLOYMENT (Wireproxy) ===
# Enable/disable proxy rotation
PROXY_ROTATION_ENABLED=true

# Path to wireproxy configuration files
PROXY_CONFIG_PATH=./config/wireproxy

# Rotation strategy: round-robin, random, or least-used
# - round-robin: Cycles through proxies in order (default)
# - random: Randomly selects a proxy
# - least-used: Selects proxy with fewest requests
PROXY_ROTATION_STRATEGY=round-robin

# Session timeout in milliseconds
# How long to keep same IP for a session before rotating
# Default: 3600000 (1 hour)
# For aggressive rotation: 600000 (10 minutes)
# For sticky sessions: 7200000 (2 hours)
PROXY_SESSION_TIMEOUT=3600000

# Wireproxy binary location (if not in PATH)
# WIREPROXY_BINARY=/usr/local/bin/wireproxy

# Health check interval (ms)
PROXY_HEALTH_CHECK_INTERVAL=30000

